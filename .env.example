# =============================================================================
# Configuración del sistema RAG
# Copia este archivo a `.env` y ajusta los valores.
# =============================================================================

# -----------------------------------------------------------------------------
# Entorno
# -----------------------------------------------------------------------------
# local: todo corre en tu máquina (Ollama + Qdrant local o Docker).
# cloud: se usan proveedores comerciales para LLM y/o embeddings.
APP_ENV=local

# -----------------------------------------------------------------------------
# Modelos
# -----------------------------------------------------------------------------
# Proveedor del chat: ollama | openai | gemini
LLM_PROVIDER=ollama

# Proveedor de embeddings. Si se omite, se reutiliza LLM_PROVIDER.
# Útil para combinar, por ejemplo, LLM_PROVIDER=openai con embeddings Ollama.
# EMBEDDING_PROVIDER=ollama

# URL del servidor Ollama.
OLLAMA_BASE_URL=http://localhost:11434

# Ventana de contexto de Ollama en tokens. 4096 evita truncar el prompt RAG.
OLLAMA_NUM_CTX=4096

# Modelo de chat. Para Ollama: `ollama pull llama3.2`.
LLM_MODEL=llama3.2

# Modelo de embeddings. Para Ollama: `ollama pull nomic-embed-text`.
EMBEDDING_MODEL=nomic-embed-text

# Temperatura del LLM. En RAG se recomienda 0.0-0.2 para reducir alucinaciones.
TEMPERATURE=0.1

# Fragmentos recuperados por consulta.
TOP_K=4

# Umbral opcional de similitud coseno (mayor es mejor). Si se define, descarta
# fragmentos débiles y puede activar la respuesta "sin contexto".
# Rango recomendado: 0.20 - 0.35 según el modelo. Desactivado si se omite.
# MIN_RELEVANCE_SCORE=0.25

# -----------------------------------------------------------------------------
# Chunking (RecursiveCharacterTextSplitter, en caracteres)
# -----------------------------------------------------------------------------
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# -----------------------------------------------------------------------------
# Qdrant
# -----------------------------------------------------------------------------
# local_path: Qdrant embebido y persistido en disco (sin Docker).
# server:     servidor Qdrant por HTTP (local o Qdrant Cloud).
QDRANT_MODE=local_path

# Ruta usada cuando QDRANT_MODE=local_path.
QDRANT_PATH=./data/qdrant_storage

# URL usada cuando QDRANT_MODE=server.
QDRANT_URL=http://localhost:6333

# API key opcional para Qdrant Cloud o servidores protegidos.
# QDRANT_API_KEY=

# Timeout de red en segundos.
QDRANT_TIMEOUT=30

# Nombre de la colección vectorial.
COLLECTION_NAME=rag_documents

# -----------------------------------------------------------------------------
# Credenciales de proveedores comerciales
# -----------------------------------------------------------------------------
# Necesaria si LLM_PROVIDER=openai o EMBEDDING_PROVIDER=openai.
# OPENAI_API_KEY=sk-...

# Necesaria si LLM_PROVIDER=gemini o EMBEDDING_PROVIDER=gemini.
# GOOGLE_API_KEY=...

# -----------------------------------------------------------------------------
# Interfaz y diagnóstico
# -----------------------------------------------------------------------------
# Turnos de conversación que se conservan en `chat` (0 desactiva el historial).
MAX_HISTORY_TURNS=6

# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
